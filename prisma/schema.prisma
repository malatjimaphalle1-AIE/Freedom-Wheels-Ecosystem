// Freedom Wheels — subscription-first schema
// No "deposits", no "yield", no investment product structures.
// Members pay subscriptions; platform earns external affiliate commissions; platform distributes a share of those commissions back.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  name         String?
  passwordHash String?
  tier         Tier           @default(STARTER)
  status       MemberStatus   @default(PENDING_PAYMENT)
  isAdmin      Boolean        @default(false) // founder / operator flag
  payfastToken String? // token from PayFast subscription tokenisation
  magicToken   String? // for magic-link login
  magicTokenExpiry DateTime?
  // Marketing fields
  referralCode String?  @unique // e.g. "MAPHALLE1" — member's personal referral code
  referredById String?  // User who referred this member (null if organic)
  referredBy   User?    @relation("Referrals", fields: [referredById], references: [id])
  referrals    User[]   @relation("Referrals")
  // UTM tracking (captured at signup)
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  utmTerm     String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  subscriptions    Subscription[]
  payments         SubscriptionPayment[]
  payouts          PayoutRequest[]
  distributions    RevenueShareDistribution[]
  affiliateClicks  AffiliateClick[]
  socialShares     SocialShare[]
}

enum Tier {
  STARTER
  PRO
  ELITE
}

enum MemberStatus {
  PENDING_PAYMENT // signed up but hasn't completed first PayFast payment
  ACTIVE          // current on subscription
  PAST_DUE        // payment failed but in grace period
  CANCELLED       // user cancelled, access ends at period end
  BANNED          // compliance ban
}

model Subscription {
  id                String            @id @default(cuid())
  userId            String
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier              Tier
  amountCents       Int               // subscription price in ZAR cents (e.g. 9900 = R99.00)
  billingCycle      BillingCycle      @default(MONTHLY)
  status            SubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([userId])
  @@index([status])
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

model SubscriptionPayment {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId  String?
  payfastPaymentId String? // pf_payment_id from PayFast
  amountCents     Int
  currency        String   @default("ZAR")
  status          PaymentStatus
  rawPayload      String?  // full ITN payload for audit
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([status])
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  CANCELLED
}

// External affiliate partners (Amazon, Hostinger, etc.) — public list
model AffiliatePartner {
  id            String   @id @default(cuid())
  name          String   @unique
  url           String   // public-facing URL
  affiliateUrl  String   // internal — actual tracking link with ref id
  commissionRate String  // human-readable, e.g. "1-10%"
  category      String   // e.g. "Hosting", "Domains", "Design"
  logoUrl       String?
  description   String
  isActive      Boolean  @default(true)
  displayOrder  Int      @default(100)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  commissions   AffiliateCommission[]
  clicks        AffiliateClick[]
  guideLinks    GuidePartnerLink[]
}

// Tracks when members click affiliate links (for member dashboard + transparency)
model AffiliateClick {
  id            String   @id @default(cuid())
  partnerId     String
  partner       AffiliatePartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  userId        String?  // null if anonymous (not logged in)
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId     String?  // for anonymous tracking
  userAgent     String?
  referrer      String?
  createdAt     DateTime @default(now())

  @@index([partnerId])
  @@index([userId])
  @@index([createdAt])
}

// Real external affiliate revenue earned by the platform
model AffiliateCommission {
  id           String   @id @default(cuid())
  partnerId    String
  partner      AffiliatePartner @relation(fields: [partnerId], references: [id])
  amountCents  Int      // in ZAR cents (converted from USD/EUR at receipt time)
  currency     String   @default("ZAR")
  sourceRef    String?  // order ID / transaction ref from partner
  recordedAt   DateTime @default(now())
  notes        String?

  @@index([partnerId])
  @@index([recordedAt])
}

// Monthly pool — calculated from AffiliateCommission minus platform costs
model RevenueSharePool {
  id                  String   @id @default(cuid())
  month               String   @unique // "YYYY-MM"
  totalRevenueCents   Int      // sum of AffiliateCommission for the month
  platformShareCents  Int      // retained for operations
  distributableCents  Int      // totalRevenue - platformShare
  starterSharePct     Int      @default(10) // % of distributable for Starter tier
  proSharePct         Int      @default(25)
  eliteSharePct       Int      @default(50)
  // remaining 15% goes to platform growth reserve
  starterMembers      Int      // count of active Starter members at distribution time
  proMembers          Int
  eliteMembers        Int
  totalMembers        Int
  distributedAt       DateTime?
  publishedAt         DateTime?
  createdAt           DateTime @default(now())

  distributions       RevenueShareDistribution[]
}

// Per-member distribution entry — what each member received in a given month
model RevenueShareDistribution {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  poolId       String
  pool         RevenueSharePool @relation(fields: [poolId], references: [id])
  tier         Tier
  amountCents  Int
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([poolId])
}

// Member requests payout of accumulated distributions
model PayoutRequest {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountCents  Int
  status       PayoutStatus @default(PENDING)
  method       String?  // "bank_transfer", "payfast_wallet", etc.
  reference    String?  // payout reference from processor
  requestedAt  DateTime @default(now())
  processedAt  DateTime?
  notes        String?

  @@index([userId])
  @@index([status])
}

enum PayoutStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

// Public monthly transparency report (one row per month)
model TransparencyReport {
  id                  String   @id @default(cuid())
  month               String   @unique // "YYYY-MM"
  totalMembers        Int
  newMembers          Int
  churnedMembers      Int
  totalRevenueCents   Int
  platformShareCents  Int
  distributableCents  Int
  totalDistributedCents Int
  partnerBreakdown    String   // JSON string: {partnerId: amountCents}
  publishedAt         DateTime @default(now())
  notes               String?

  createdAt           DateTime @default(now())
}

// Buying guides — content marketing that drives affiliate clicks.
// Some guides are public (free preview), some are member-only.
// All contain affiliate links to the platform's partners.
model Guide {
  id              String   @id @default(cuid())
  slug            String   @unique // URL-friendly identifier
  title           String
  excerpt         String   // short summary shown in listings
  contentMarkdown String   // full guide content as Markdown
  coverImageUrl   String?
  category        String   // e.g. "Laptops", "Books", "Hosting", "Design Tools"
  tags            String   // comma-separated tags
  metaDescription String?  // SEO meta description (155 chars max) — used in search results + social previews
  isMemberOnly    Boolean  @default(false) // if true, only logged-in members can read full content
  isPublished     Boolean  @default(false)
  publishedAt     DateTime?
  authorId        String?  // null = founder; could be a user ID for guest authors
  viewCount       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  partnerLinks    GuidePartnerLink[]

  @@index([isPublished, publishedAt])
  @@index([category])
}

// Tracks which affiliate partners are linked in each guide (for click analytics)
model GuidePartnerLink {
  id          String   @id @default(cuid())
  guideId     String
  guide       Guide    @relation(fields: [guideId], references: [id], onDelete: Cascade)
  partnerId   String
  partner     AffiliatePartner @relation(fields: [partnerId], references: [id])
  createdAt   DateTime @default(now())

  @@unique([guideId, partnerId])
  @@index([guideId])
}

// Social shares — tracks when members click share buttons
// Used for marketing analytics (which platforms drive the most traffic)
model SocialShare {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  platform    String   // 'whatsapp' | 'facebook' | 'twitter' | 'linkedin' | 'telegram' | 'email' | 'copy'
  urlShared   String   // the URL that was shared
  page        String   // 'landing' | 'guide' | 'member_dashboard' | etc.
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([platform])
  @@index([createdAt])
}

// Tracks visits from referral links + UTM-tagged URLs
// Used for marketing attribution + founder analytics
model ReferralVisit {
  id            String   @id @default(cuid())
  referralCode  String?  // the ref=CODE param
  utmSource     String?
  utmMedium     String?
  utmCampaign   String?
  utmContent    String?
  utmTerm       String?
  landingPage   String   // the page they landed on
  userAgent     String?
  ipAddress     String?  // hashed for privacy
  converted     Boolean  @default(false) // true if they signed up
  convertedUserId String? // the User ID if they converted
  createdAt     DateTime @default(now())

  @@index([referralCode])
  @@index([utmSource])
  @@index([createdAt])
}

// Product of the Day — featured product on landing page
// Admin sets one active product at a time. Old ones are kept for history.
model ProductOfTheDay {
  id            String   @id @default(cuid())
  productName   String   // e.g. "Lenovo IdeaPad 3 (Ryzen 5)"
  asin          String?  // Amazon ASIN (for affiliate link)
  affiliateUrl  String   // full affiliate URL with tag
  imageUrl      String?  // product image URL
  description   String   // short pitch (1-2 sentences)
  originalPrice String?  // e.g. "R13,999" (display string)
  dealPrice     String?  // e.g. "R11,499" (display string, optional)
  whyWeLikeIt   String?  // longer explanation of why it's recommended
  category      String?  // e.g. "Laptops", "Networking"
  isActive      Boolean  @default(false) // only one should be active at a time
  scheduledAt   DateTime? // when this product should auto-activate (null = no scheduling)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isActive])
  @@index([scheduledAt])
  @@index([createdAt])
}

// Newsletter subscribers — email capture on landing page
// "Get notified when we publish new guides"
model NewsletterSubscriber {
  id          String   @id @default(cuid())
  email       String   @unique
  name        String?
  source      String?  // 'landing_page' | 'guide' | 'member' etc.
  utmSource   String?
  utmCampaign String?
  isActive    Boolean  @default(true) // can unsubscribe
  createdAt   DateTime @default(now())

  @@index([email])
  @@index([createdAt])
}

// Page views — for analytics dashboard (daily/weekly trends)
model PageView {
  id          String   @id @default(cuid())
  path        String   // e.g. '/', '/guides/best-laptops', '/member'
  userAgent   String?
  referrer    String?
  ipAddress   String?  // hashed for privacy
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  userId      String?  // null if anonymous
  createdAt   DateTime @default(now())

  @@index([path])
  @@index([createdAt])
  @@index([utmSource])
}
